# Copy this file to `.env` in the skill install directory and fill in real values.

ZENTAO_BASE_URL="https://your-zentao.example.com/zentao"
ZENTAO_ACCOUNT="your-account"
ZENTAO_PASSWORD="your-password"

# Optional:
ZENTAO_API_PREFIX="/api.php/v1"
ZENTAO_TOKEN="existing-token"
# Defaults to "主干" when resolving a bug after commenting.
ZENTAO_RESOLVED_BUILD="主干"
ZENTAO_RESOLVE_BUG_AFTER_COMMENT="1"
